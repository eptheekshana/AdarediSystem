# TiDB Environment Configuration Template
# Copy this to .env and fill in your TiDB cluster details

# ============================================
# TiDB Connection Details
# ============================================

# TiDB Host (e.g., my-cluster.tidbcloud.com or localhost for Docker)
TIDB_HOST=your-cluster-id.tidbcloud.com

# TiDB Port (default: 4000)
TIDB_PORT=4000

# Database name
TIDB_DB=bedsheet_db

# TiDB username (default: root)
TIDB_USER=root

# TiDB password (your chosen password)
TIDB_PASSWORD=your_password

# ============================================
# Spring Boot Database Configuration
# ============================================

# JDBC connection URL (auto-generated by helper script, but can be manual)
SPRING_DATASOURCE_URL=jdbc:mysql://your-cluster-id.tidbcloud.com:4000/bedsheet_db?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Database username
SPRING_DATASOURCE_USERNAME=root

# Database password
SPRING_DATASOURCE_PASSWORD=your_password

# Database driver
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ============================================
# JPA/Hibernate Settings
# ============================================

# Schema generation strategy: validate | update | create | create-drop
# Use 'validate' for production after applying schema manually
# Use 'update' for development (auto-creates/updates tables)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Show SQL queries
SPRING_JPA_SHOW_SQL=false

# Hibernate dialect for TiDB (MySQL compatible)
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect

# ============================================
# Application Settings
# ============================================

# Server port
PORT=8080

# Application name
SPRING_APPLICATION_NAME=adaredi-orders

# Thymeleaf caching (true for production, false for development)
SPRING_THYMELEAF_CACHE=false

# ============================================
# Connection Pool Settings (HikariCP)
# ============================================

# Maximum number of connections
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20

# Minimum idle connections
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5

# Connection timeout in milliseconds
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# Idle timeout in milliseconds
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000

# Max lifetime in milliseconds
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000

# ============================================
# Curfox/Royal Express Integration (Optional)
# ============================================

# Enable Curfox integration
CURFOX_ENABLED=false

# Curfox API base URL
CURFOX_API_BASE_URL=https://v1.api.curfox.com

# Curfox lists API base URL
CURFOX_LISTS_API_BASE_URL=https://v2-lists.api.curfox.com/api

# Curfox tenant name
CURFOX_TENANT=royalexpress

# Curfox merchant email
CURFOX_EMAIL=your_merchant_email@example.com

# Curfox merchant password (use quotes if password contains special chars: "you#pass")
CURFOX_PASSWORD=your_merchant_password

# Curfox merchant business ID (9212 for Adaredi.com)
CURFOX_MERCHANT_BUSINESS_ID=9212

# Curfox merchant business name
CURFOX_MERCHANT_BUSINESS_NAME=Adaredi.com

# Curfox origin city (pickup location, must match Curfox city names)
CURFOX_ORIGIN_CITY_NAME=Colombo

# Curfox origin state/province
CURFOX_ORIGIN_STATE_NAME=Western Province

# Auto sync order to Curfox on creation
CURFOX_AUTO_SYNC=true

# ============================================
# TiDB Cloud Specific Settings (if using TiDB Cloud)
# ============================================

# SSL Mode: required (TiDB Cloud), prefer (self-hosted)
# Already included in SPRING_DATASOURCE_URL with useSSL=true

# Character encoding
SPRING_JPA_PROPERTIES_HIBERNATE_CONNECTION_CHARACTER_ENCODING=utf8mb4
SPRING_JPA_PROPERTIES_HIBERNATE_CONNECTION_USE_UNICODE=true

# ============================================
# Usage Notes
# ============================================

# 1. For TiDB Cloud:
#    - Host: Get from TiDB Cloud console (Cluster > Connection > Public Endpoint)
#    - Port: Usually 4000
#    - User: Usually 'root' or your created user
#    - Password: Your chosen password
#    - Add ?useSSL=true to connection string

# 2. For Self-Hosted/Docker TiDB:
#    - Host: localhost or your server IP
#    - Port: 4000
#    - User: root (default)
#    - Password: Set during TiDB initialization
#    - useSSL can be false for local development

# 3. Loading this file:
#    - Place in project root as .env
#    - Application auto-loads via spring-dotenv dependency
#    - OR manually export variables before running

# 4. To use with migration script:
#    $ source .env
#    $ bash docs/tidb-migrate.sh full-migration

# 5. Important: NEVER commit .env to version control!
#    - It contains sensitive credentials
#    - .env is in .gitignore

