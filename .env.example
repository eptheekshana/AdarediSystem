DB_HOST=your-db-host.db.ondigitalocean.com
DB_PORT=25060
DB_NAME=defaultdb
DB_USERNAME=doadmin
DB_PASSWORD=your_password_here
DB_SSLMODE=REQUIRED

# Royal Express (Curfox) — https://royalexpress.merchant.curfox.com
CURFOX_ENABLED=true
CURFOX_API_BASE_URL=https://v1.api.curfox.com
CURFOX_LISTS_API_BASE_URL=https://v2-lists.api.curfox.com/api
CURFOX_TENANT=royalexpress
CURFOX_EMAIL=your_merchant_email
CURFOX_PASSWORD="your_merchant_password"
# Fabrics by Inu (default business on Royal Express)
CURFOX_MERCHANT_BUSINESS_ID=673
CURFOX_MERCHANT_BUSINESS_NAME=Fabrics by Inu
# Pickup origin
CURFOX_ORIGIN_CITY_NAME=Kotte
CURFOX_ORIGIN_STATE_NAME=Colombo
CURFOX_AUTO_SYNC=true
